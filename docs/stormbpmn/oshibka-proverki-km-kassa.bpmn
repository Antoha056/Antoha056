<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_KassaKm"
                  name="Ошибка проверки КМ на кассе"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="StormBPMN compatible"
                  exporterVersion="1.0">
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_Cash" value="Касса: М в чеке не значит, что КМ принят"/>
    <bpmn:categoryValue id="CategoryValue_Type" value="Короткий в ошибке, полный на ФН"/>
    <bpmn:categoryValue id="CategoryValue_Cause" value="Сканер или сам код"/>
    <bpmn:categoryValue id="CategoryValue_Q" value="Карантин"/>
  </bpmn:category>
  <bpmn:process id="Process_KassaKm" name="Ошибка проверки КМ, маркировка будет отвергнута" isExecutable="false">
    <bpmn:documentation>В ошибке ПО по умолчанию приписывает короткий КМ (MarkingType2 3), а на кассу приходит полный. ФН сверяет полный код с коротким шаблоном — LocalError 1. Чек при этом может закрыться с М: это не М+, вывод в ЧЗ не считать выполненным. Тип брать со скана: 93 короткий, 91/92 полный. Полный буфер не резать.</bpmn:documentation>
    <bpmn:group id="Group_Cash" categoryValueRef="CategoryValue_Cash"/>
    <bpmn:group id="Group_Type" categoryValueRef="CategoryValue_Type"/>
    <bpmn:group id="Group_Cause" categoryValueRef="CategoryValue_Cause"/>
    <bpmn:group id="Group_Q" categoryValueRef="CategoryValue_Q"/>
    <bpmn:startEvent id="StartEvent_1" name="Старт" />
    <bpmn:userTask id="Task_Scan" name="Сканировать Data Matrix" />
    <bpmn:serviceTask id="Task_FN" name="ФН проверяет формат КМ" />
    <bpmn:exclusiveGateway id="Gateway_FN" name="LocalError 0 и Result 1?" gatewayDirection="Diverging" />
    <bpmn:exclusiveGateway id="Gateway_JoinOk" gatewayDirection="Converging" />
    <bpmn:serviceTask id="Task_Ok" name="Строка с КИЗ в чек" />
    <bpmn:endEvent id="EndEvent_Ok" name="Вывод через кассу" />
    <bpmn:userTask id="Task_Rescan" name="Повторить скан той же единицы" />
    <bpmn:exclusiveGateway id="Gateway_Rescan" name="Повтор принят?" gatewayDirection="Diverging" />
    <bpmn:exclusiveGateway id="Gateway_Kind" name="В ошибке короткий, на ФН полный?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_TypeFix" name="Слать полный КМ, не короткий шаблон" />
    <bpmn:endEvent id="EndEvent_Type" name="Тип взят со скана" />
    <bpmn:serviceTask id="Task_Parse" name="Разобрать GS и криптохвост" />
    <bpmn:exclusiveGateway id="Gateway_GS" name="В КМ есть GS и 93 или 91/92?" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_Scanner" name="Настроить сканер на ASCII 29" />
    <bpmn:endEvent id="EndEvent_IT" name="Продажа отложена, править сканер" />
    <bpmn:userTask id="Task_CHZ" name="Проверить КМ в Честном знаке" />
    <bpmn:exclusiveGateway id="Gateway_CHZ" name="КМ наш и в обороте?" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_Hold" name="Отложить единицу, вызвать IT" />
    <bpmn:endEvent id="EndEvent_Hold" name="Не продавать как остаток" />
    <bpmn:userTask id="Task_Quarantine" name="Карантин, уведомить бухгалтера" />
    <bpmn:endEvent id="EndEvent_Q" name="Возврат поставщику" />
    <bpmn:sequenceFlow id="Flow_s1" sourceRef="StartEvent_1" targetRef="Task_Scan" />
    <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_Scan" targetRef="Task_FN" />
    <bpmn:sequenceFlow id="Flow_s3" sourceRef="Task_FN" targetRef="Gateway_FN" />
    <bpmn:sequenceFlow id="Flow_fn_yes" sourceRef="Gateway_FN" targetRef="Gateway_JoinOk" name="Да" />
    <bpmn:sequenceFlow id="Flow_fn_no" sourceRef="Gateway_FN" targetRef="Task_Rescan" name="Нет, ошибка формата" />
    <bpmn:sequenceFlow id="Flow_r1" sourceRef="Task_Rescan" targetRef="Gateway_Rescan" />
    <bpmn:sequenceFlow id="Flow_re_yes" sourceRef="Gateway_Rescan" targetRef="Gateway_JoinOk" name="Да" />
    <bpmn:sequenceFlow id="Flow_join_ok" sourceRef="Gateway_JoinOk" targetRef="Task_Ok" />
    <bpmn:sequenceFlow id="Flow_ok_end" sourceRef="Task_Ok" targetRef="EndEvent_Ok" />
    <bpmn:sequenceFlow id="Flow_re_no" sourceRef="Gateway_Rescan" targetRef="Gateway_Kind" name="Нет" />
    <bpmn:sequenceFlow id="Flow_kind_yes" sourceRef="Gateway_Kind" targetRef="Task_TypeFix" name="Да, этот дамп" />
    <bpmn:sequenceFlow id="Flow_type_end" sourceRef="Task_TypeFix" targetRef="EndEvent_Type" />
    <bpmn:sequenceFlow id="Flow_kind_no" sourceRef="Gateway_Kind" targetRef="Task_Parse" name="Нет" />
    <bpmn:sequenceFlow id="Flow_p1" sourceRef="Task_Parse" targetRef="Gateway_GS" />
    <bpmn:sequenceFlow id="Flow_gs_no" sourceRef="Gateway_GS" targetRef="Task_Scanner" name="Нет, сканер съел GS" />
    <bpmn:sequenceFlow id="Flow_it_end" sourceRef="Task_Scanner" targetRef="EndEvent_IT" />
    <bpmn:sequenceFlow id="Flow_gs_yes" sourceRef="Gateway_GS" targetRef="Task_CHZ" name="Да" />
    <bpmn:sequenceFlow id="Flow_c1" sourceRef="Task_CHZ" targetRef="Gateway_CHZ" />
    <bpmn:sequenceFlow id="Flow_chz_yes" sourceRef="Gateway_CHZ" targetRef="Task_Hold" name="Да" />
    <bpmn:sequenceFlow id="Flow_hold_end" sourceRef="Task_Hold" targetRef="EndEvent_Hold" />
    <bpmn:sequenceFlow id="Flow_chz_no" sourceRef="Gateway_CHZ" targetRef="Task_Quarantine" name="Нет, брак кода" />
    <bpmn:sequenceFlow id="Flow_q_end" sourceRef="Task_Quarantine" targetRef="EndEvent_Q" />
  </bpmn:process>
