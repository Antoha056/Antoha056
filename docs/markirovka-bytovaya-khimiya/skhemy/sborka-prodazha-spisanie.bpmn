<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_OutboundHimii"
                  name="Сборка, продажа и списание бытовой химии"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="StormBPMN compatible"
                  exporterVersion="1.0">
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_A" value="Сборка заказа"/>
    <bpmn:categoryValue id="CategoryValue_C" value="Касса розницы и магазина запчастей"/>
    <bpmn:categoryValue id="CategoryValue_S" value="СТО: товарный чек или расход на авто"/>
  </bpmn:category>
  <bpmn:process id="Process_OutboundHimii" name="Сборка, касса, списание на авто" isExecutable="false">
    <bpmn:documentation>Сборка и складские накладные не смешивают статусы: при обоих типах единиц — две накладные. Кассовый чек с 01.07.2026 один на покупку, нал и безнал одинаковы; смешанный чек разрешён, склад режет движения. На авто маркированный расход в работу выводится в Честный знак в ОСУ без кассы; законный остаток в ЧЗ не отправляется.</bpmn:documentation>
    <bpmn:group id="Group_A" categoryValueRef="CategoryValue_A"/>
    <bpmn:group id="Group_C" categoryValueRef="CategoryValue_C"/>
    <bpmn:group id="Group_S" categoryValueRef="CategoryValue_S"/>
    <bpmn:startEvent id="StartEvent_1" name="Старт" />
    <bpmn:exclusiveGateway id="Gateway_Channel" name="Какая операция?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_AOpen" name="Показать остатки обоих двойников" />
    <bpmn:userTask id="Task_AScan" name="Сканировать единицу на сборке" />
    <bpmn:exclusiveGateway id="Gateway_ADM" name="Data Matrix?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_AM" name="Строка артикула-М, сначала остаток FIFO" />
    <bpmn:serviceTask id="Task_AU" name="Строка артикула-остатка" />
    <bpmn:exclusiveGateway id="Gateway_AMore" name="Ещё единицы?" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="Gateway_AMix" name="В сборке оба статуса?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_AOne" name="Одна расходная накладная" />
    <bpmn:serviceTask id="Task_ATwo" name="Две однородные накладные" />
    <bpmn:endEvent id="EndEvent_A" name="Сборка закрыта" />
    <bpmn:userTask id="Task_CScan" name="Сканировать товар на кассе" />
    <bpmn:exclusiveGateway id="Gateway_CDM" name="Data Matrix?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_CM" name="Строка с КИЗ в чек" />
    <bpmn:serviceTask id="Task_CU" name="Строка остатка без КИЗ" />
    <bpmn:exclusiveGateway id="Gateway_CMore" name="Ещё товары?" gatewayDirection="Converging" />
    <bpmn:userTask id="Task_CCheck" name="Один чек: нал или безнал" />
    <bpmn:serviceTask id="Task_CPost" name="Чек режется на 1–2 складских движения" />
    <bpmn:endEvent id="EndEvent_C" name="Продажа через кассу" />
    <bpmn:userTask id="Task_SScan" name="Сканировать единицу под авто" />
    <bpmn:exclusiveGateway id="Gateway_SDM" name="Data Matrix?" gatewayDirection="Diverging" />
    <bpmn:exclusiveGateway id="Gateway_SKindM" name="Продажа или расход в работу?" gatewayDirection="Diverging" />
    <bpmn:exclusiveGateway id="Gateway_SKindU" name="Продажа или расход в работу?" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_SSaleM" name="Товарный чек с КИЗ" />
    <bpmn:serviceTask id="Task_SUseM" name="Списание + вывод в ЧЗ ОСУ" />
    <bpmn:userTask id="Task_SSaleU" name="Товарный чек без КИЗ" />
    <bpmn:serviceTask id="Task_SUseU" name="Только складское списание" />
    <bpmn:endEvent id="EndEvent_S" name="Операция на авто закрыта" />
    <bpmn:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="Gateway_Channel" />
    <bpmn:sequenceFlow id="Flow_to_a" sourceRef="Gateway_Channel" targetRef="Task_AOpen" name="Сборка" />
    <bpmn:sequenceFlow id="Flow_to_c" sourceRef="Gateway_Channel" targetRef="Task_CScan" name="Касса, нал и безнал" />
    <bpmn:sequenceFlow id="Flow_to_s" sourceRef="Gateway_Channel" targetRef="Task_SScan" name="Списание на авто" />
    <bpmn:sequenceFlow id="Flow_a1" sourceRef="Task_AOpen" targetRef="Task_AScan" />
    <bpmn:sequenceFlow id="Flow_a2" sourceRef="Task_AScan" targetRef="Gateway_ADM" />
    <bpmn:sequenceFlow id="Flow_a_m" sourceRef="Gateway_ADM" targetRef="Task_AM" name="Да" />
    <bpmn:sequenceFlow id="Flow_a_u" sourceRef="Gateway_ADM" targetRef="Task_AU" name="Нет" />
    <bpmn:sequenceFlow id="Flow_am_more" sourceRef="Task_AM" targetRef="Gateway_AMore" />
    <bpmn:sequenceFlow id="Flow_au_more" sourceRef="Task_AU" targetRef="Gateway_AMore" />
    <bpmn:sequenceFlow id="Flow_a_loop" sourceRef="Gateway_AMore" targetRef="Task_AScan" name="Да" />
    <bpmn:sequenceFlow id="Flow_a_done" sourceRef="Gateway_AMore" targetRef="Gateway_AMix" name="Нет" />
    <bpmn:sequenceFlow id="Flow_a_one" sourceRef="Gateway_AMix" targetRef="Task_AOne" name="Один статус" />
    <bpmn:sequenceFlow id="Flow_a_two" sourceRef="Gateway_AMix" targetRef="Task_ATwo" name="Оба статуса" />
    <bpmn:sequenceFlow id="Flow_a_end1" sourceRef="Task_AOne" targetRef="EndEvent_A" />
    <bpmn:sequenceFlow id="Flow_a_end2" sourceRef="Task_ATwo" targetRef="EndEvent_A" />
    <bpmn:sequenceFlow id="Flow_c1" sourceRef="Task_CScan" targetRef="Gateway_CDM" />
    <bpmn:sequenceFlow id="Flow_c_m" sourceRef="Gateway_CDM" targetRef="Task_CM" name="Да" />
    <bpmn:sequenceFlow id="Flow_c_u" sourceRef="Gateway_CDM" targetRef="Task_CU" name="Нет" />
    <bpmn:sequenceFlow id="Flow_cm_more" sourceRef="Task_CM" targetRef="Gateway_CMore" />
    <bpmn:sequenceFlow id="Flow_cu_more" sourceRef="Task_CU" targetRef="Gateway_CMore" />
    <bpmn:sequenceFlow id="Flow_c_loop" sourceRef="Gateway_CMore" targetRef="Task_CScan" name="Да" />
    <bpmn:sequenceFlow id="Flow_c_done" sourceRef="Gateway_CMore" targetRef="Task_CCheck" name="Нет" />
    <bpmn:sequenceFlow id="Flow_c2" sourceRef="Task_CCheck" targetRef="Task_CPost" />
    <bpmn:sequenceFlow id="Flow_c3" sourceRef="Task_CPost" targetRef="EndEvent_C" />
    <bpmn:sequenceFlow id="Flow_s1" sourceRef="Task_SScan" targetRef="Gateway_SDM" />
    <bpmn:sequenceFlow id="Flow_s_m" sourceRef="Gateway_SDM" targetRef="Gateway_SKindM" name="Да, маркированный" />
    <bpmn:sequenceFlow id="Flow_s_u" sourceRef="Gateway_SDM" targetRef="Gateway_SKindU" name="Нет, остаток" />
    <bpmn:sequenceFlow id="Flow_sm_sale" sourceRef="Gateway_SKindM" targetRef="Task_SSaleM" name="Продажа" />
    <bpmn:sequenceFlow id="Flow_sm_use" sourceRef="Gateway_SKindM" targetRef="Task_SUseM" name="Расход" />
    <bpmn:sequenceFlow id="Flow_su_sale" sourceRef="Gateway_SKindU" targetRef="Task_SSaleU" name="Продажа" />
    <bpmn:sequenceFlow id="Flow_su_use" sourceRef="Gateway_SKindU" targetRef="Task_SUseU" name="Расход" />
    <bpmn:sequenceFlow id="Flow_end_Task_SSaleM" sourceRef="Task_SSaleM" targetRef="EndEvent_S" />
    <bpmn:sequenceFlow id="Flow_end_Task_SUseM" sourceRef="Task_SUseM" targetRef="EndEvent_S" />
    <bpmn:sequenceFlow id="Flow_end_Task_SSaleU" sourceRef="Task_SSaleU" targetRef="EndEvent_S" />
    <bpmn:sequenceFlow id="Flow_end_Task_SUseU" sourceRef="Task_SUseU" targetRef="EndEvent_S" />
  </bpmn:process>
