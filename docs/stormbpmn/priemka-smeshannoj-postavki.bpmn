<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PriemkaHimii"
                  name="Приёмка смешанной поставки бытовой химии"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="StormBPMN compatible"
                  exporterVersion="1.0">
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_Scan" value="Скан классифицирует единицу"/>
    <bpmn:categoryValue id="CategoryValue_Docs" value="Накладные всегда однородные"/>
  </bpmn:category>
  <bpmn:process id="Process_PriemkaHimii" name="Приёмка смешанной поставки" isExecutable="false">
    <bpmn:documentation>Один артикул не бывает маркированным и немаркированным сразу. Скан Data Matrix кладёт единицу на артикул-М, отсутствие кода и дата до контрольной — на артикул-остаток. Смешанная поставка (3 канистры с КИЗ и 2 без) режется на две однородные накладные. Маркированный приход закрывается УПД ЭДО в ОСУ (GTIN + количество). Законный остаток в Честный знак не передаётся.</bpmn:documentation>
    <bpmn:group id="Group_Scan" categoryValueRef="CategoryValue_Scan"/>
    <bpmn:group id="Group_Docs" categoryValueRef="CategoryValue_Docs"/>
    <bpmn:startEvent id="StartEvent_1" name="Старт" />
    <bpmn:userTask id="Task_Open" name="Открыть поставку поставщика" />
    <bpmn:userTask id="Task_Scan" name="Отсканировать каждую единицу 2D" />
    <bpmn:exclusiveGateway id="Gateway_DM" name="На упаковке Data Matrix?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_ToMarked" name="В буфер артикула-М" />
    <bpmn:exclusiveGateway id="Gateway_Date" name="Дата производства до контрольной?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_ToUnmarked" name="В буфер артикула-остатка" />
    <bpmn:userTask id="Task_Quarantine" name="Карантин, возврат поставщику" />
    <bpmn:endEvent id="EndEvent_Quarantine" name="Поставка отклонена" />
    <bpmn:exclusiveGateway id="Gateway_More" name="Есть ещё единицы?" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="Gateway_Mix" name="В поставке оба статуса?" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Task_InvM" name="Одна накладная: только маркированный" />
    <bpmn:serviceTask id="Task_InvU" name="Одна накладная: только остаток" />
    <bpmn:serviceTask id="Task_Inv2" name="Две однородные накладные" />
    <bpmn:userTask id="Task_UTD" name="Подписать УПД ЭДО GTIN + количество" />
    <bpmn:userTask id="Task_Plain" name="Принять остаток без Честного знака" />
    <bpmn:userTask id="Task_UTD2" name="Подписать УПД ЭДО по маркированным" />
    <bpmn:userTask id="Task_Plain2" name="Принять остаток отдельной накладной" />
    <bpmn:endEvent id="EndEvent_Ok" name="Приёмка закрыта" />
    <bpmn:sequenceFlow id="Flow_s1" sourceRef="StartEvent_1" targetRef="Task_Open" />
    <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_Open" targetRef="Task_Scan" />
    <bpmn:sequenceFlow id="Flow_s3" sourceRef="Task_Scan" targetRef="Gateway_DM" />
    <bpmn:sequenceFlow id="Flow_dm_yes" sourceRef="Gateway_DM" targetRef="Task_ToMarked" name="Да, КИЗ" />
    <bpmn:sequenceFlow id="Flow_dm_no" sourceRef="Gateway_DM" targetRef="Gateway_Date" name="Нет кода" />
    <bpmn:sequenceFlow id="Flow_date_yes" sourceRef="Gateway_Date" targetRef="Task_ToUnmarked" name="Да, остаток" />
    <bpmn:sequenceFlow id="Flow_date_no" sourceRef="Gateway_Date" targetRef="Task_Quarantine" name="Нет, после даты" />
    <bpmn:sequenceFlow id="Flow_q1" sourceRef="Task_Quarantine" targetRef="EndEvent_Quarantine" />
    <bpmn:sequenceFlow id="Flow_m_more" sourceRef="Task_ToMarked" targetRef="Gateway_More" />
    <bpmn:sequenceFlow id="Flow_u_more" sourceRef="Task_ToUnmarked" targetRef="Gateway_More" />
    <bpmn:sequenceFlow id="Flow_loop" sourceRef="Gateway_More" targetRef="Task_Scan" name="Да" />
    <bpmn:sequenceFlow id="Flow_no_more" sourceRef="Gateway_More" targetRef="Gateway_Mix" name="Нет" />
    <bpmn:sequenceFlow id="Flow_only_m" sourceRef="Gateway_Mix" targetRef="Task_InvM" name="Только маркированный" />
    <bpmn:sequenceFlow id="Flow_only_u" sourceRef="Gateway_Mix" targetRef="Task_InvU" name="Только остаток" />
    <bpmn:sequenceFlow id="Flow_both" sourceRef="Gateway_Mix" targetRef="Task_Inv2" name="Оба, как 5 канистр" />
    <bpmn:sequenceFlow id="Flow_utm" sourceRef="Task_InvM" targetRef="Task_UTD" />
    <bpmn:sequenceFlow id="Flow_upu" sourceRef="Task_InvU" targetRef="Task_Plain" />
    <bpmn:sequenceFlow id="Flow_u2" sourceRef="Task_Inv2" targetRef="Task_UTD2" />
    <bpmn:sequenceFlow id="Flow_p2" sourceRef="Task_UTD2" targetRef="Task_Plain2" />
    <bpmn:sequenceFlow id="Flow_end_m" sourceRef="Task_UTD" targetRef="EndEvent_Ok" />
    <bpmn:sequenceFlow id="Flow_end_u" sourceRef="Task_Plain" targetRef="EndEvent_Ok" />
    <bpmn:sequenceFlow id="Flow_end_2" sourceRef="Task_Plain2" targetRef="EndEvent_Ok" />
  </bpmn:process>
